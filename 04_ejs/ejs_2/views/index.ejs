<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student List</title>

    <link rel="stylesheet" href="/index.css">
</head>

<body>

    <h1>Student List</h1>

    <a href="/add">Add Student</a>

    <ul>

        <% studentList.forEach((m)=> { %>

            <li>
                <%= m.name %>

                    <a href="/delete/<%= m.id %>">
                        Delete
                    </a>

                    <a href="/edit/<%= m.id %>">
                        Edit
                    </a>
            </li>

            <% }) %>

    </ul>

</body>

</html>