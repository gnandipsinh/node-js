<!DOCTYPE html>
<html>
<head>
    <title>Add Student</title>
</head>
<body>

    <h1>Add Student</h1>

    <form action="/add" method="POST">

        <input
            type="text"
            name="name"
            placeholder="Enter Student Name"
        >

        <input
            type="number"
            name="age"
            placeholder="Enter Student Age"
        >

        <button type="submit">Add Student</button>

    </form>

</body>
</html>