<!DOCTYPE html>
<html>
<head>
    <title>Student List</title>
</head>
<body>

    <h1>Student List</h1>

    <a href="/add">Add Student</a>

    <ul>

        <% StudentList.forEach((student) => { %>

            <li>
                Name: <%= student.name %>
                | Age: <%= student.age %>
            </li>

        <% }) %>

    </ul>

</body>
</html>