<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student</title>
</head>
<body>

    <h1>Edit Student</h1>

    <form action="/edit/<%= student.id %>" method="post">

        <input 
            type="text" 
            name="name" 
            value="<%= student.name %>"
        >

        <button type="submit">Update</button>

    </form>

</body>
</html>
