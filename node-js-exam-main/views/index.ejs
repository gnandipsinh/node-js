<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>student list</title>

</head>

<body>

    <h1>student List</h1>


    <a href="/add">Add student</a>

    <ul>

        <% StudentList.forEach((s)=>{%>

            <li>
                <%= s.name%>
                    <a href="/delete/<%= s.id %>">Delete</a>
                    <a href="/edit/<%= s.id %>">Edit</a>
            </li>

            <%})%>

    </ul>


</body>

</html>